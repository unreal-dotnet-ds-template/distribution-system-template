{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure.Core": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FeatureManagement": {
    "RandomWeatherTraffic": {
      "EnabledFor": [
        {
          "Name": "TrafficGeneration",
          "Parameters": {
            "Enabled": false
          }
        }
      ]
    }
  },
  "TrafficGeneration": {
    "StartupDelay": "00:05:00",
    "RequestsPerSecond": 20,
    "MaxRequestsPerSecond": 100,
    "MaxConcurrency": 100
  }
}
