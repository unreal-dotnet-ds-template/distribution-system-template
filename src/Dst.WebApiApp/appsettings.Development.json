{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FeatureManagement": {
    "RandomWeatherTraffic": {
      "EnabledFor": [
        {
          "Name": "TrafficGeneration",
          "Parameters": {
            "Enabled": true
          }
        }
      ]
    }
  },
  "TrafficGeneration": {
    "StartupDelay": "00:00:05",
    "RequestsPerSecond": 50,
    "MaxRequestsPerSecond": 200
  }
}
