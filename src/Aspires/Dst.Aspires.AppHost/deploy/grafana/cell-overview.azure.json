          "refId": "A",
          "queryType": "Azure Log Analytics",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "__DS_UID__"
          },
          "azureLogAnalytics": {
            "resultFormat": "time_series",
            "resources": [
              "$cell"
            ],
            "query": "AppMetrics | where $__timeFilter(TimeGenerated) | where Name == 'http.server.request.duration' | where tostring(Properties['http.route']) !in ('/health', '/alive') | extend status = tostring(Properties['http.response.status_code']) | where status !startswith '5' | summarize ['Requests per second'] = sum(ItemCount) / 60.0 by bin(TimeGenerated, 1m), ['HTTP status'] = status | order by TimeGenerated asc"
          }
        },
        {
          "refId": "B",
          "queryType": "Azure Log Analytics",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "__DS_UID__"
          },
          "azureLogAnalytics": {
            "resultFormat": "time_series",
            "resources": [
              "$cell"
            ],
            "query": "AppMetrics | where $__timeFilter(TimeGenerated) | where Name == 'http.server.request.duration' | extend status = toint(Properties['http.response.status_code']) | summarize ['Failures per second'] = sumif(ItemCount, status >= 500) / 60.0, ['Avg response time'] = sumif(Sum, AppRoleName endswith '/dst-web-api' and tostring(Properties['http.route']) !in ('/health', '/alive')) / sumif(ItemCount, AppRoleName endswith '/dst-web-api' and tostring(Properties['http.route']) !in ('/health', '/alive')) by bin(TimeGenerated, 1m) | order by TimeGenerated asc"
          }
        }
      ],
      "description": "Requests per second by service and HTTP status code, plus failures per second (HTTP 5xx, red), on the left axis; Web API average response time on the right axis. Health probes are excluded from requests.",
      "title": "Traffic, failures and latency",
      "type": "timeseries"
