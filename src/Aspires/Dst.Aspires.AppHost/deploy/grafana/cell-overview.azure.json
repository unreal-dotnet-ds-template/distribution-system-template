      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 30
      },
      "id": 30,
      "options": {
        "orientation": "horizontal",
        "xField": "Grain type",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "Azure Log Analytics",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "__DS_UID__"
          },
          "azureLogAnalytics": {
            "resultFormat": "table",
            "resources": [
              "$cell"
            ],
            "query": "AppMetrics | where $__timeFilter(TimeGenerated) | where TimeGenerated > ago(5m) | where Name == 'orleans-catalog-activations' | extend g = tostring(Properties['grain_type']) | where isnotempty(g) and g !startswith 'sys.' and g !in ('dashboard', 'management') | summarize arg_max(TimeGenerated, Sum) by AppRoleName, AppRoleInstance, AppVersion, g | summarize Active = sum(Sum) by ['Grain type'] = g | top 10 by Active desc"
          }
        }
      ],
      "title": "Top 10 grain types",
      "type": "barchart",
      "description": "The 10 application grain types with the most active instances (in memory) right now, summed across replicas and builds. Labels show only the grain type.",
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Active",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "__DS_UID__"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 30
      },
      "id": 31,
      "options": {
        "pieType": "pie",
        "displayLabels": [
          "name",
          "value"
        ],
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "Azure Log Analytics",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "__DS_UID__"
          },
          "azureLogAnalytics": {
            "resultFormat": "table",
            "resources": [
              "$cell"
            ],
            "query": "let win = 5m; let m = AppMetrics | where TimeGenerated > ago(win) | where AppRoleName endswith '-web-orleans-silo-ca' or (AppRoleName endswith '-web-orleans-silo-ca' or AppRoleName endswith '/dst-web-orleans-silo'); let silos = m | summarize by AppRoleInstance; let builds = m | where Name == 'dst.build.info' | extend Build = tostring(Properties['app.build.number']) | where isnotempty(Build) | summarize arg_max(TimeGenerated, Build) by AppRoleInstance | project AppRoleInstance, Build; let grains = m | where Name == 'orleans-catalog-activations' | extend g = tostring(Properties['grain_type']) | where isnotempty(g) and g !startswith 'sys.' and g !in ('dashboard', 'management') | summarize arg_max(TimeGenerated, Sum) by AppRoleInstance, g | summarize Active = sum(Sum) by AppRoleInstance; silos | join kind=leftouter grains on AppRoleInstance | join kind=leftouter builds on AppRoleInstance | project Instance = strcat(AppRoleInstance, ' @ ', iff(isempty(Build), 'unknown', Build)), Active = coalesce(Active, 0.0) | order by Instance asc"
          }
        }
      ],
      "title": "Active grains per silo",
      "type": "piechart",
      "description": "Distribution of currently active application grains across silo replicas (latest samples within 5 minutes). Each slice represents one silo; values are grain counts. The legend includes idle silos with 0; if all counts are zero, there are no slices. System grains are excluded.",
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "Instance",
                "handlerKey": "field.name"
              },
              {
                "fieldName": "Active",
                "handlerKey": "field.value"
              }
            ]
          }
        }
      ]
    },
