        "uid": "__DS_UID__"
      },
      "description": "The 10 application grain types with the most active instances (in memory) right now.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "axisPlacement": "auto"
          },
          "decimals": 0,
          "min": 0,
          "noValue": "No grains",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 30
      },
      "id": 30,
      "options": {
        "orientation": "horizontal",
        "xField": "Grain type",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "Azure Log Analytics",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "__DS_UID__"
          },
          "azureLogAnalytics": {
            "resultFormat": "table",
            "resources": [
              "$cell"
            ],
            "query": "AppMetrics | where $__timeFilter(TimeGenerated) | where Name == 'orleans-catalog-activations' | extend g = tostring(Properties['grain_type']) | where g !startswith 'sys.' and g !in ('dashboard', 'management') | where TimeGenerated > ago(5m) | summarize arg_max(TimeGenerated, Sum) by AppRoleInstance, g | summarize Active = sum(Sum) by ['Grain type'] = g | top 10 by Active desc"
          }
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Active",
                "desc": true
              }
            ]
          }
        }
      ],
      "title": "Top 10 grain types",
      "type": "barchart"
    },
