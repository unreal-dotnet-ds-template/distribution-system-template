          "azureLogAnalytics": {
            "resultFormat": "time_series",
            "resources": [
              "$cell"
            ],
            "query": "AppMetrics | where $__timeFilter(TimeGenerated) | where Name == 'http.server.request.duration' | where tostring(Properties['http.route']) !in ('/health', '/alive') | extend status = tostring(Properties['http.response.status_code']) | where status !startswith '5' | summarize ['Requests per second'] = sum(ItemCount) / 60.0 by bin(TimeGenerated, 1m), ['HTTP status'] = status | order by TimeGenerated asc"
          }
