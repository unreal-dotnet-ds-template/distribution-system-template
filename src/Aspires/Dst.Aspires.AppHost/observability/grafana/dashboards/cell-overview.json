    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The 10 application grain types with the most active instances (in memory) right now, summed across replicas within the selected build. Labels show only the grain type.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "axisPlacement": "auto"
          },
          "decimals": 0,
          "min": 0,
          "noValue": "No grains",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 30
      },
      "id": 30,
      "options": {
        "orientation": "horizontal",
        "xField": "Grain type",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "topk(10, sum by (grain_type) (orleans_catalog_activations{app_cell_id=\"$cell\", app_build_number=\"$build\", grain_type!~\"sys\\\\..*|dashboard|management\"}))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
