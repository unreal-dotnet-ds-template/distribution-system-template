              "Value": "Active"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Active",
                "desc": true
              }
            ]
          }
        }
      ],
      "title": "Top 10 grain types",
      "type": "barchart"
    },
